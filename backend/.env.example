# Copy this file to .env and adjust the paths for your machine.

# Paths to the two AI model repos this app orchestrates.
ACE_STEP_DIR=E:\AI\ACE\ACE-Step-1.5
YUE2_DIR=E:\AI\YuE2-3B

# Separate uv-managed venv/project for Demucs (stem separation).
# setup_models.ps1 sets this up automatically in external/Demucs; only
# change it if you'd rather manage that uv project somewhere else yourself
# (same recipe: "uv add demucs numpy", plus routing "torch" at PyTorch's
# cu128 wheel index so it's a CUDA build, not a CPU-only one - see
# setup_models.ps1 for the exact pyproject.toml). htdemucs model weights
# auto-download on first use (needs internet access once).
DEMUCS_DIR=E:\AI\Demucs

# Seed-VC checkout used by Voice Clone (extract, train, apply). Defaults to
# external/seed-vc. setup_voice.sh creates that folder and its virtualenv.
# SEED_VC_DIR=E:\AI\seed-vc

# GPT-SoVITS checkout for talking / audiobook speech clone (MIT). Defaults to
# external/gpt-sovits. Run ./setup_speech.sh then download weights yourself.
# OpenFabric does not auto-download weights. Pin HTTP API: api.py on :9880.
# OPENFABRIC_GPT_SOVITS_DIR=/Users/seth/Documents/GitHub/OpenFabricStudio/openfabric-studio/external/gpt-sovits
# GPT_SOVITS_DIR=/Users/seth/Documents/GitHub/OpenFabricStudio/openfabric-studio/external/gpt-sovits
# OPENFABRIC_GPT_SOVITS_API_URL=http://127.0.0.1:9880
# OPENFABRIC_SPEECH_CLONE_MOCK=1

# ffmpeg bin dir (used by ACE-Step's process launch and by our own
# non-WAV-upload transcoding for YuE2). setup_models.ps1 fills this in
# automatically by locating the ffmpeg winget install from
# setup_prereqs.bat; only change it if ffmpeg lives somewhere else on your
# machine. The CUDA toolkit bin dir below is needed on PATH for YuE2's
# audiocpp_server.exe to find its CUDA DLLs, and is not auto-filled.
FFMPEG_BIN_DIR=E:\AI\ACE\tools\ffmpeg-shared\ffmpeg-master-latest-win64-gpl-shared\bin
CUDA_BIN_DIR=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.4\bin

# Where songs, voices, videos, singing models, logs, and the catalog live.
# Leave unset for backend/data (logs go in its logs folder). The Data folder
# on the home page overrides OPENFABRIC_DATA_DIR after a restart. The desktop
# app sets OPENFABRIC_LOG_DIR itself, next to its data folder.
# OPENFABRIC_DATA_DIR=D:\OpenFabricStudio\data
# OPENFABRIC_LOG_DIR=D:\OpenFabricStudio\logs

# Optional internal model API ports. Useful when another local service already
# occupies OpenFabric Studio defaults. These APIs remain loopback-only.
# ACE_STEP_API_PORT=8001
# YUE2_SERVER_PORT=8080

# Optional Linux/headless settings. Leave device values blank to let each
# backend choose automatically. Setting both to different device values also
# opts into concurrent model residency; otherwise switching remains exclusive.
# UV_BIN=/absolute/path/to/uv
# CUDA_LIB_DIR=/usr/local/cuda/lib64
# ACE_STEP_DEVICE=0
# YUE2_SERVER_HOST=127.0.0.1
# YUE2_DEVICE=1

# Optional ACE-Step checkpoint folder names under ACE_STEP_DIR/checkpoints.
# Defaults are the fast turbo DiT and the 1.7B LM. On a machine with at
# least 24GB of memory, ACE-Step's higher-quality pair is the XL sft DiT
# and the 4B LM. Download them with acestep-download before pointing here.
# ACE_STEP_DIT_MODEL=acestep-v15-xl-sft
# ACE_STEP_LM_MODEL=acestep-5Hz-lm-4B
# Load a different downloaded DiT when the form asks for one (xl-base is
# the model that supports extract, lego, and complete).
# ACE_STEP_ON_DEMAND_MODEL_LOAD=true

# Optional installed MSST vocal separator for the Voice Clone RoFormer mode.
# setup_roformer.sh downloads/verifies the pinned Kimberley vocal checkpoint,
# installs its matching config and fills these values. Restart the backend.
# These examples are for manually managed matching artifacts.
# VOICE_ROFORMER_DIR=/absolute/path/to/Music-Source-Separation-Training
# VOICE_ROFORMER_MODEL_TYPE=mel_band_roformer
# VOICE_ROFORMER_CONFIG=/absolute/path/to/vocal-config.yaml
# VOICE_ROFORMER_CHECKPOINT=/absolute/path/to/vocal-model.ckpt

+++ b/acestep/api/http/cancel_task_route.py
@@ -0,0 +1,107 @@
+"""HTTP route for cancelling a queued or in-flight generation task."""
+
+from __future__ import annotations
+
+from typing import Any, Callable, Dict, Optional
+
+from fastapi import FastAPI, Header, Request
+
+from acestep.generation_cancellation import request_cancel
+
+
+def register_cancel_task_route(
+    app: FastAPI,
+    verify_token_from_request: Callable[[dict, Optional[str]], Optional[str]],
+    wrap_response: Callable[..., Dict[str, Any]],
+    store: Any,
+) -> None:
+    """Register the ``/cancel_task`` endpoint.
+
+    Args:
+        app: FastAPI app instance to register the route on.
+        verify_token_from_request: Auth validator matching ``/release_task``.
+        wrap_response: Response envelope builder preserving client contract.
+        store: In-memory job store with ``get(task_id)``/``mark_cancelled(task_id)``.
+    """
+
+    @app.post("/cancel_task")
+    async def cancel_task_endpoint(request: Request, authorization: Optional[str] = Header(None)):
+        """Cancel one task by ID.
+
+        A still-queued task is marked cancelled immediately so it never
+        starts. A running task has its cancellation event set: the
+        generation loop notices at its next checkpoint (next LM token, or
+        after the current diffusion pass) and unwinds cleanly instead of
+        completing.
+        """
+
+        content_type = (request.headers.get("content-type") or "").lower()
+        if "json" in content_type:
+            body = await request.json()
+        else:
+            form = await request.form()
+            body = {key: value for key, value in form.items()}
+
+        verify_token_from_request(body, authorization)
+        task_id = body.get("task_id")
+        if not task_id:
+            return wrap_response(None, code=400, error="task_id is required")
+
+        record = store.get(task_id)
+        if record is None:
+            return wrap_response(None, code=404, error="Task not found")
+
+        if record.status in ("succeeded", "failed", "cancelled"):
+            return wrap_response({"task_id": task_id, "status": record.status})
+
+        was_queued = record.status == "queued"
+        request_cancel(task_id)
+        if was_queued:
+            # Never picked up by a worker yet -- mark cancelled directly so
+            # polling clients see it right away. If a worker races and
+            # dequeues it anyway, run_one_job_runtime re-checks the
+            # cancellation event before doing any real work.
+            store.mark_cancelled(task_id)
+            return wrap_response({"task_id": task_id, "status": "cancelled"})
+
+        return wrap_response({"task_id": task_id, "status": "cancelling"})
+
+
+def register_cancel_all_tasks_route(
+    app: FastAPI,
+    verify_token_from_request: Callable[[dict, Optional[str]], Optional[str]],
+    wrap_response: Callable[..., Dict[str, Any]],
+    store: Any,
+) -> None:
+    """Register the ``/cancel_all_tasks`` endpoint.
+
+    Cancels every queued or running job in one call -- same per-job logic as
+    ``/cancel_task``, just looped over ``store.get_active_ids()``.
+    """
+
+    @app.post("/cancel_all_tasks")
+    async def cancel_all_tasks_endpoint(request: Request, authorization: Optional[str] = Header(None)):
+        content_type = (request.headers.get("content-type") or "").lower()
+        if "json" in content_type:
+            try:
+                body = await request.json()
+            except Exception:
+                body = {}
+        else:
+            form = await request.form()
+            body = {key: value for key, value in form.items()}
+
+        verify_token_from_request(body, authorization)
+
+        cancelled = []
+        for task_id in store.get_active_ids():
+            record = store.get(task_id)
+            if record is None or record.status in ("succeeded", "failed", "cancelled"):
+                continue
+            was_queued = record.status == "queued"
+            request_cancel(task_id)
+            if was_queued:
+                store.mark_cancelled(task_id)
+            cancelled.append({"task_id": task_id, "status": "cancelled" if was_queued else "cancelling"})
+
+        return wrap_response({"cancelled": cancelled, "count": len(cancelled)})

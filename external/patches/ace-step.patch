new file mode 100644
index 0000000..0071d9e
--- /dev/null
+++ b/stop_acestep.bat
@@ -0,0 +1,35 @@
+@echo off
+setlocal enabledelayedexpansion
+REM ACE-Step Server Stopper
+REM Stops any ACE-Step server (Gradio UI / REST API) listening on the
+REM ports used by start_api_server.bat, start_gradio_ui.bat or run_acestep_1.5.bat
+
+REM ==================== Configuration ====================
+set PORTS=7860 8001
+
+REM ==================== Stop ====================
+set FOUND=0
+
+for %%P in (%PORTS%) do (
+    for /f "tokens=5" %%A in ('netstat -ano ^| findstr /R /C:":%%P .*LISTENING"') do (
+        set "PID=%%A"
+        if not "!PID!"=="0" (
+            echo Stopping ACE-Step process on port %%P ^(PID !PID!^)...
+            taskkill /PID !PID! /T /F >nul 2>&1
+            if !ERRORLEVEL! EQU 0 (
+                echo   Done.
+                set FOUND=1
+            ) else (
+                echo   Failed to stop PID !PID!.
+            )
+        )
+    )
+)
+
+if "!FOUND!"=="0" (
+    echo No ACE-Step server found listening on ports: %PORTS%
+)
+
+echo.
+pause
+endlocal

diff --git a/acestep/generation_cancellation.py b/acestep/generation_cancellation.py
new file mode 100644
index 0000000..12f126e
--- /dev/null
+++ b/acestep/generation_cancellation.py
@@ -0,0 +1,91 @@
+"""Cooperative cancellation primitives for in-flight generation jobs.
+
+Generation runs synchronously on a worker thread (see
+``acestep.api.job_execution_runtime``). There is no safe way to kill that
+thread from the outside, so cancellation is cooperative: the thread running
+a job binds its ``threading.Event`` as "current" for that thread, and deep
+call sites (LM token-generation loops, the diffusion call site) poll
+``check_cancelled()`` and raise :class:`GenerationCancelledError` when the
+event is set. This keeps cancellation out of function signatures across the
+many layers between the API route and the actual sampling loops.
+"""
+
+from __future__ import annotations
+
+import threading
+from typing import Dict, Optional
+
+
+class GenerationCancelledError(Exception):
+    """Raised from within a generation call stack once cancellation fires."""
+
+
+_lock = threading.Lock()
+_events: Dict[str, threading.Event] = {}
+_current = threading.local()
+
+
+def register(job_id: str) -> threading.Event:
+    """Create (or reset) the cancellation event for a newly created job."""
+
+    event = threading.Event()
+    with _lock:
+        _events[job_id] = event
+    return event
+
+
+def unregister(job_id: str) -> None:
+    """Drop the cancellation event once a job reaches a terminal state."""
+
+    with _lock:
+        _events.pop(job_id, None)
+
+
+def request_cancel(job_id: str) -> bool:
+    """Signal cancellation for ``job_id``. Returns False if it is unknown."""
+
+    with _lock:
+        event = _events.get(job_id)
+    if event is None:
+        return False
+    event.set()
+    return True
+
+
+def is_cancel_requested(job_id: str) -> bool:
+    """Non-raising check for whether cancellation was requested."""
+
+    with _lock:
+        event = _events.get(job_id)
+    return bool(event and event.is_set())
+
+
+class bind_current:
+    """Context manager binding ``job_id``'s event as current for this thread."""
+
+    def __init__(self, job_id: str) -> None:
+        with _lock:
+            self._event = _events.get(job_id)
+        self._previous: Optional[threading.Event] = None
+
+    def __enter__(self) -> "bind_current":
+        self._previous = getattr(_current, "event", None)
+        _current.event = self._event
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> bool:
+        _current.event = self._previous
+        return False
+
+
+def check_cancelled() -> None:
+    """Raise :class:`GenerationCancelledError` if the current job was cancelled.
+
+    Safe to call from anywhere: outside of a ``bind_current`` block (e.g. on
+    the asyncio event loop thread, or in tests) there is no current event and
+    this is a no-op.
+    """
+
+    event = getattr(_current, "event", None)
+    if event is not None and event.is_set():
+        raise GenerationCancelledError("Generation cancelled by user")

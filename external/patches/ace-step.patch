diff --git a/acestep/training/export_safety.py b/acestep/training/export_safety.py
new file mode 100644
--- /dev/null
+++ b/acestep/training/export_safety.py
@@ -0,0 +1,84 @@
+"""Exclusive adapter exports: existing files and training data are never replaced."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import stat
+from pathlib import Path
+
+
+class ExportPathError(ValueError):
+    """A rejected export path, with a safe message for the user."""
+
+
+def _export_paths(source_path: str, export_path: str, output_dir: str) -> tuple[Path, Path]:
+    if not export_path.strip() or not output_dir.strip():
+        raise ExportPathError("Training output and a new export destination are required.")
+    source_input = Path(source_path)
+    root = Path(output_dir).resolve(strict=True)
+    source = source_input.resolve(strict=True)
+    if source_input.is_symlink() or not source.is_relative_to(root):
+        raise ExportPathError("Export source must remain inside the training output without symbolic links.")
+    requested = Path(export_path.strip())
+    if os.path.lexists(requested):
+        raise FileExistsError
+    destination = requested.resolve()
+    if destination == root or destination.is_relative_to(root) or root.is_relative_to(destination):
+        raise ExportPathError("Choose an export destination outside the training output folder.")
+    if os.path.lexists(destination):
+        raise FileExistsError
+    return source, destination
+
+
+def _copy_file(source: Path, destination: Path) -> None:
+    if source.resolve(strict=True) != source or not stat.S_ISREG(source.lstat().st_mode):
+        raise ExportPathError("Adapter exports require regular source files without symbolic links.")
+    if destination.parent.resolve(strict=True) != destination.parent or not destination.parent.is_dir():
+        raise ExportPathError("The export destination changed; choose a new path.")
+    with os.fdopen(os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)), "rb") as reader:
+        if not stat.S_ISREG(os.fstat(reader.fileno()).st_mode):
+            raise ExportPathError("Adapter exports require regular source files.")
+        with destination.open("xb") as writer:
+            shutil.copyfileobj(reader, writer)
+
+
+def _copy_tree(source: Path, destination: Path) -> None:
+    if source.resolve(strict=True) != source or not stat.S_ISDIR(source.lstat().st_mode):
+        raise ExportPathError("Adapter exports require source directories without symbolic links.")
+    if destination.parent.resolve(strict=True) != destination.parent or not destination.parent.is_dir():
+        raise ExportPathError("The export destination changed; choose a new path.")
+    destination.mkdir()
+    for child in source.iterdir():
+        mode = child.lstat().st_mode
+        if stat.S_ISDIR(mode):
+            _copy_tree(child, destination / child.name)
+        elif stat.S_ISREG(mode):
+            _copy_file(child, destination / child.name)
+        else:
+            raise ExportPathError("Adapter exports cannot contain symbolic links or special files.")
+
+
+def export_directory_safely(source_path: str, export_path: str, output_dir: str) -> str:
+    """Copy weights into a new directory, retaining partial output on failure."""
+    source, destination = _export_paths(source_path, export_path, output_dir)
+    if not source.is_dir():
+        raise ExportPathError("The trained adapter directory is unavailable.")
+    if any(path.is_symlink() for path in source.rglob("*")):
+        raise ExportPathError("Adapter exports cannot contain symbolic links.")
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    _copy_tree(source, destination)
+    return str(destination)
+
+
+def export_lokr_file_safely(source_path: str, export_path: str, output_dir: str) -> str:
+    """Copy one LoKr file to a new file or a new export directory."""
+    source, destination = _export_paths(source_path, export_path, output_dir)
+    if not source.is_file():
+        raise ExportPathError("The trained adapter file is unavailable.")
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    if not str(destination).lower().endswith(".safetensors"):
+        destination.mkdir()
+        destination = destination / "lokr_weights.safetensors"
+    _copy_file(source, destination)
+    return str(destination)

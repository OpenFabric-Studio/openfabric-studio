+@contextmanager
+def writer_lock(path: Path, cancel_file: Path | None = None) -> Iterator[None]:
+    """OS-owned locks survive process termination without stale lock ownership."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a+b") as handle:
+        if os.name == "nt":
+            import msvcrt
+            if handle.seek(0, 2) == 0:
+                handle.write(b"0")
+                handle.flush()
+        else:
+            import fcntl
+        while True:
+            if cancellation_requested(cancel_file):
+                raise InstallCancelled("download cancelled by user")
+            try:
+                if os.name == "nt":
+                    handle.seek(0)
+                    msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+                else:
+                    fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+                break
+            except OSError as error:
+                if error.errno not in (errno.EAGAIN, errno.EACCES):
+                    raise
+                time.sleep(0.1)
+        try:
+            yield
+        finally:
+            if os.name == "nt":
+                handle.seek(0)
+                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
+def atomic_download_identity(path: Path, identity: DownloadIdentity) -> None:
+    temporary: Path | None = None
+    try:
+        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as handle:
+            temporary = Path(handle.name)
+            json.dump(asdict(identity), handle, sort_keys=True)
+            handle.flush()
+            os.fsync(handle.fileno())
+        temporary.replace(path)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+
+
+def content_digest(info: RemoteFileInfo) -> tuple[str, str]:
+    etag = info.etag.strip('"').lower()
+    if re.fullmatch(r"[0-9a-f]{64}", etag):
+        return "sha256", etag
+    if re.fullmatch(r"[0-9a-f]{40}", etag):
+        return "git-sha1", etag
+    raise ManagerError("remote content has no supported immutable digest; refusing an unverified model download")
+
+
+def verified_download(path: Path, info: RemoteFileInfo) -> bool:
+    if not path.is_file() or (info.size is not None and path.stat().st_size != info.size):
+        return False
+    algorithm, expected = content_digest(info)
+    digest = hashlib.sha256() if algorithm == "sha256" else hashlib.sha1()
+    if algorithm == "git-sha1":
+        digest.update(f"blob {path.stat().st_size}\0".encode("ascii"))
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest() == expected
+

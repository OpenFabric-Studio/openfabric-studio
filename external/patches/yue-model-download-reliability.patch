 class InstallCancelled(ManagerError):
     pass
+
+
+DOWNLOAD_ATTEMPTS = 3
+DOWNLOAD_STALL_SECONDS = 45
+TRANSIENT_HTTP = frozenset((408, 429, 500, 502, 503, 504))
+
+
+class RetryableDownload(ManagerError):
+    def __init__(self, delay: float | None = None) -> None:
+        self.delay = delay
+        super().__init__("download interrupted; verified partial data retained")
+
+
+def open_download(request: Request) -> HTTPResponse:
+    try:
+        return urlopen(request, timeout=DOWNLOAD_STALL_SECONDS)
+    except HTTPError as error:
+        if error.code not in TRANSIENT_HTTP:
+            raise
+        value = error.headers.get("Retry-After", "")
+        delay = min(30.0, max(0.0, float(value))) if re.fullmatch(r"[0-9]{1,3}(?:\.[0-9]{1,3})?", value) else None
+        error.close()
+        raise RetryableDownload(delay) from error
+    except (URLError, OSError) as error:
+        raise RetryableDownload() from error
+
+
+def download_progress(remote_path: str, received: int, total: int | None, attempt: int,
+                      phase: str, enabled: bool, delay: float | None = None) -> None:
+    if enabled:
+        payload = {"artifact_name": Path(remote_path).name[-120:], "bytes_received": received,
+                   "total_bytes": total, "attempt": attempt, "max_attempts": DOWNLOAD_ATTEMPTS,
+                   "phase": phase, "retry_after_sec": delay}
+        print("OPENFABRIC_DOWNLOAD_PROGRESS " + json.dumps(payload), flush=True)
 
 

# Keep patches byte-exact: blank context lines require a leading space.
# The desktop installer applies them without Git; native manifests hash them.
external/patches/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Keep pinned upstream regression excerpts byte-exact for patch application.
backend/app/fixtures/ace-*/*.py.txt text eol=lf whitespace=-blank-at-eol,-blank-at-eof
